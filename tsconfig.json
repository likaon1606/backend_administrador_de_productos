{
  "compilerOptions": {
    "outDir": "./dist",                    // Donde se guardarán los archivos compilados.
    "rootDir": "./src",                    // El directorio raíz de los archivos TypeScript.
    "lib": ["ESNext"],                     // Asegura que se usen características de ESNext.
    "strict": false,                        // Desactiva las reglas estrictas si no las necesitas.
    "sourceMap": true,                     // Genera archivos sourceMap para depuración.
    "esModuleInterop": true,               // Para manejar módulos de CommonJS y ES Modules correctamente.
    "declaration": true,                   // Genera archivos de declaración .d.ts.
    "target": "ES2020",                    // Usar ES2020 como objetivo de salida.
    "module": "ESNext",                    // Configura el módulo como ESNext para soportar import/export.
    "moduleResolution": "Node",            // Resolución de módulos similar a Node.js.
    "resolveJsonModule": true,             // Permite importar archivos JSON como módulos.
    "skipLibCheck": true                   // Ignora la comprobación de tipo en los archivos de las bibliotecas.
  },
  "include": ["src/**/*.ts"]                // Asegura que todos los archivos TS en src se incluyan.
}
